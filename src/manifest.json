{
	"manifest_version": 2,
	"name": "Tab Groups",
	"version": "1.0.0",
	"description": "Chrome-style tab groups for Zotero: color-coded, collapsible, drag-and-drop tab groups that survive restarts.",
	"author": "Xuan",
	"icons": {
		"48": "content/icons/icon.svg",
		"96": "content/icons/icon.svg"
	},
	"applications": {
		"zotero": {
			"id": "zotero-tab-groups@zotero-tab-groups",
			"update_url": "https://raw.githubusercontent.com/CalyrexThePal/zotero-tab-groups/main/updates.json",
			"strict_min_version": "10.0",
			"strict_max_version": "10.0.*"
		}
	}
}
